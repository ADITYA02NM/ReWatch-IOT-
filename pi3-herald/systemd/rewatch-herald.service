[Unit]
Description=ReWatch(Iot) Herald — SMTP alerts (Pi 3, TL-WN722N)
After=network-online.target mosquitto.service
Wants=network-online.target
[Service]
Type=simple
User=rewatch
EnvironmentFile=/etc/rewatch/rewatch.env
ExecStart=/opt/rewatch/venv/bin/python /opt/rewatch/pi3-herald/mailer.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
[Install]
WantedBy=multi-user.target
