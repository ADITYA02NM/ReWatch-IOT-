# Copy to demo/.env. This file is read as KEY=VALUE, not executed as shell code.
DEMO_CODE=rewatch
DEMO_PORT=8080
DEMO_ACK_TIMEOUT_S=20
DEMO_AUTO_SPIKE=1
# Cosmetic prompt followed by unverified local demo unlock, even on cancel.
# OFF by default; NEVER deploy this recording-only mode as authentication.
DEMO_PASSKEY_PREVIEW=0
# Preview only by default. Use a NEW app password after revoking exposed ones.
DEMO_SEND_MAIL=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_TO=
SMTP_IFACE=
DASHBOARD_URL=http://localhost:8080
