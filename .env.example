# ReWatch environment — copy to /etc/rewatch/rewatch.env on each node.
# start.sh writes this for you; edit by hand only to tune.

# ── MQTT broker (the Pi 4 core) ──────────────────────────────────────────────
REWATCH_MQTT_HOST=192.168.100.1
REWATCH_MQTT_PORT=1883
REWATCH_MQTT_USER=
REWATCH_MQTT_PASS=

# ── Dashboard (Pi 4) ─────────────────────────────────────────────────────────
REWATCH_HOSTNAME=rewatch.local
REWATCH_RP_ID=rewatch.local
REWATCH_PORT=8080
REWATCH_DATA_DIR=/var/lib/rewatch
# For HTTPS + passkeys over the network, point these at tools/make_local_ca.sh output:
#REWATCH_TLS_CERT=/etc/rewatch/certs/server.crt
#REWATCH_TLS_KEY=/etc/rewatch/certs/server.key
#REWATCH_PORT=443
# Fallback sign-in code for laptops that cannot use a passkey (leave blank to disable):
REWATCH_ACCESS_CODE=

# ── Sentinel (Pi 3, detection) ───────────────────────────────────────────────
SENTINEL_IFACE=eth0
SENTINEL_USB_MOUNT=/mnt/rewatch-usb
SENTINEL_LEARN_S=300
AC_CRITICAL_C=32

# ── Verifier (Pi 4, AC600 Wi-Fi) ─────────────────────────────────────────────
VERIFY_IFACE=wlan1
VERIFY_TOLERANCE_C=1.5

# ── Herald (Pi 3, SMTP over TL-WN722N) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_TO=
SMTP_IFACE=wlan1
DASHBOARD_URL=https://rewatch.local

# ── Engine / responder (Pi 4) ────────────────────────────────────────────────
ACK_TIMEOUT_S=120
AC_BASELINE_C=20
RESPONDER_NFT=0
