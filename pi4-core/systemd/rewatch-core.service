[Unit]
Description=ReWatch(Iot) threat engine + responder (Pi 4 core)
After=network-online.target mosquitto.service
Wants=network-online.target
[Service]
Type=simple
User=rewatch
EnvironmentFile=/etc/rewatch/rewatch.env
ExecStart=/opt/rewatch/venv/bin/python /opt/rewatch/pi4-core/engine.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/rewatch
[Install]
WantedBy=multi-user.target
