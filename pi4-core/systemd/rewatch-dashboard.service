[Unit]
Description=ReWatch(Iot) dashboard (Pi 4 core)
After=network-online.target mosquitto.service rewatch-core.service
Wants=network-online.target
[Service]
Type=simple
User=rewatch
EnvironmentFile=/etc/rewatch/rewatch.env
ExecStart=/opt/rewatch/venv/bin/python -m server.app
WorkingDirectory=/opt/rewatch/pi4-core
Restart=always
RestartSec=5
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/rewatch
[Install]
WantedBy=multi-user.target
